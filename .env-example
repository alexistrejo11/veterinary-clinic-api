# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENVIRONMENT=development
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
# Database
# Use a host reachable from the API process/container.
DATABASE_URL=postgresql://localhost:5432/vet_database?sslmode=disable
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=vet_database
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_CONN_MAX_IDLE_TIME=30m

# Redis
REDIS_URL=redis://:change-me@localhost:6379/0
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_KEY_PREFIX=vet-clinic-api

# Authentication
# JWT_SECRET should be at least 32 characters long.
JWT_SECRET=replace-with-a-long-random-secret
# Must decode to exactly 32 bytes when base64-decoded. Generate with: openssl rand -base64 32
# This 32-zero-byte value is only for local Docker; replace it outside development.
TWO_FACTOR_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
JWT_EXPIRATION_TIME=24h
REFRESH_TOKEN_EXPIRY=168h
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=30m

# Twilio
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_PHONE=+10000000000

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
FROM_EMAIL=no-reply@example.com
FROM_NAME=Clinic Vet API
PROJECT_NAME=Clinic Vet API
LOGO_URL=

# Application
APP_NAME=Clinic Vet API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=info
ENABLE_SWAGGER=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=99
RATE_LIMIT_WINDOW=0m
RATE_LIMIT_BURST=19

# CORS
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=12h
